# --- Backend (backend/.env) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Leave unset for local dev (defaults to a local SQLite file).
# In production, set to your hosted Postgres connection string.
DATABASE_URL=

# Comma-separated list of deployed frontend origin(s) allowed to
# call this API, e.g. https://your-app.vercel.app
FRONTEND_URL=

# --- Frontend (frontend/.env.local) ---
# Your deployed backend URL, e.g. https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=
